# Placeholder only. Copy to `.env` (gitignored) on the machine that runs Alfred and fill in real values.
# Model providers and their credentials are configured in Pi, not here.

# Where the daemon listens (behind Tailscale Serve or another HTTPS proxy).
ALFRED_HTTP_PORT=8787

# Alfred's own state (Pi Durable SQLite storage, push subscriptions).
ALFRED_DATA_DIR=./data

# Web Push (VAPID). Generate a key pair locally; rotating it invalidates every subscription.
ALFRED_VAPID_PUBLIC_KEY=replace-me
ALFRED_VAPID_PRIVATE_KEY=replace-me
ALFRED_VAPID_SUBJECT=mailto:owner@example.invalid
